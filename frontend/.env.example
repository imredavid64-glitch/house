# Backend URL used by the deployed frontend on Vercel.
# For local dev, leave unset (Vite proxies /api to 127.0.0.1:8090).
#
# For production, point this at your PUBLIC PocketBase instance.
# Options:
#   1. LAN (local network only): http://192.168.x.x:8090
#   2. Away-from-home access (recommended): a Tailscale node IPv4,
#      e.g. https://my-pc.tailnet-name.ts.net:8090  (enable HTTPS/MagicDNS)
#   3. Cloudflare Tunnel: https://house.example.com
#
# NOTE: PocketBase CORS must allow the Vercel project origin.
VITE_API_URL=